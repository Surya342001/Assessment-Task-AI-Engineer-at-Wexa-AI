# Leave NEXT_PUBLIC_API_URL empty so browser requests use same-origin /api.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=

# Set this in Vercel to your Render/Railway backend URL, for example:
# INTERNAL_API_URL=https://analytics-platform-api.onrender.com
INTERNAL_API_URL=https://your-backend-host.example.com